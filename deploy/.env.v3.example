# 「见一面」v3 运行时环境变量样例
# 本文件不含任何真实密钥。生产实际值放服务器 /opt/aiditto/.env（权限 600），不要提交密钥到仓库。
# 用法：cp deploy/.env.v3.example /opt/aiditto/.env 后逐项填写 <...> 占位符。

# ---- 数据库：PostgreSQL 16（v3 分支，stringtype=unspecified 供 JSONB 写 String）----
DB_URL=jdbc:postgresql://aiditto-pg16:5432/aiditto?stringtype=unspecified
DB_USERNAME=aiditto
DB_PASSWORD=<PG_PASSWORD>

# ---- 应用 ----
DEMO_MODE=true
DEMO_LOGIN_CODE=<DEMO_CODE>
ADMIN_PHONES=
DATA_KEY=<DATA_KEY>
HASH_PEPPER=<HASH_PEPPER>
PHOTO_ROOT=/data/photos
SCHEDULER_ENABLED=true
SYNTHETIC_AUTOLOAD=true

# ---- Step 6 Agent 精排（分身模拟 + 裁判 rubric）----
# 默认 false = 逐位等同 M2 规则配对（回滚用）；灰度/仿真设为 true
# 开启后 AI 分主导配对排序，但 HardFilter 硬约束/风格门槛/展示分一律保留
MATCH_AGENT_ENABLED=true
MATCH_AGENT_TOP_PAIRS=15
MATCH_AGENT_MIN_TOTAL=72
MATCH_AGENT_SIMULATE=true
# 裁判/模拟走 LlmGateway（主 LongCat / 备 DeepSeek），无需额外 key

# ---- Step 7 AI 文案（CopyValidator 严格校验 + 模板兜底）----
# 默认 false = 逐位等同 M2 模板、零 LLM 调用；灰度/仿真设为 true
# 开启后 match_copy.source 会出现 'ai'，稳定模型下模板兜底率应 ≤5%
MATCH_COPY_AI_ENABLED=true
MATCH_COPY_MAX_ATTEMPTS=2
MATCH_COPY_MAX_TOKENS=1600
MATCH_COPY_TEMPERATURE=0.6
MATCH_COPY_PROMPT_VERSION=match-copy-v1

# ---- Step 8 反馈学习（每周期批量消费，不阻塞反馈提交）----
# 每周每用户≤1 次画像重写、单次只调 1 个权重且幅度≤0.15（服务端硬约束）
# ≥30 条「AI 预测分 vs 真人反馈」才启用裁判校准，偏置夹在 ±10
LEARNING_ENABLED=true
LEARNING_MAX_PER_SCAN=500
LEARNING_MIN_CALIBRATION_SAMPLES=30
LEARNING_CALIBRATION_CAP=10

# ---- 召回（Step 5 + 偏离补全）----
# 生产 compose 网络内用 http://aiditto-qdrant:6333；本机经 SSH 隧道用 127.0.0.1:16333
QDRANT_URL=http://aiditto-qdrant:6333
QDRANT_COLLECTION=match_user_v1
# hash = 确定性特征哈希（离线/CI 无密钥时）；openai = 真实语义 embedding
# 有效 key 已在服务器 /opt/aiditto/.env 时改 openai；切换后必须换 QDRANT_COLLECTION 全量重同步
EMBEDDING_MODE=hash
EMBEDDING_VERSION=
# 真实语义 embedding：填网关根地址即可，代码自动收敛到 /v1/embeddings
# （https://api.vveai.com 与文档中的 https://api.gpt.ge 为同一 OpenAI 兼容网关）
EMBEDDING_BASE_URL=https://api.vveai.com
EMBEDDING_API_KEY=<EMBEDDING_API_KEY>
# 2026-11-16 中文语义实测选型（6 候选对比：相关句/无关句相似度 gap + 延迟）：
#   text-embedding-v3 1024维 gap +0.184 1862ms  <- 选定（国产合规、支持 dimensions、综合最优）
#   Qwen3-Embedding-8B 1024维 gap +0.196 2236ms（语义略优但慢）
#   bge-m3 1024维 gap +0.162 2774ms
# 换其他模型时用 deploy/probe-embedding-models.py --probe 先测维度，并同步改 QDRANT_COLLECTION
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
# 切换模型或维度时必须换 QDRANT_COLLECTION 名（或清空旧 collection）后全量重同步，禁止跨版本混算
# 部分聚合网关不支持 dimensions 参数（会 400），届时设 false
EMBEDDING_SEND_DIMENSIONS=true
# 每批用户数（实际文本数 = 用户数 × 2）；网关单请求文本上限 10，所以用户数最多 5
EMBEDDING_BATCH_SIZE=5
EMBEDDING_MAX_BATCH_ITEMS=10
EMBEDDING_TIMEOUT_MS=20000
RECALL_ENABLED=true
RECALL_TASTE_TOPK=200
RECALL_PERSONA_TOPK=200
RECALL_TAG_TOPK=200
RECALL_EXPLORE_TOPK=50
RECALL_MIN_CANDIDATES=50
RECALL_COARSE_TOPN=15
RECALL_RRF_K=60
RECALL_HNSW_EF=256
RECALL_MAX_HNSW_EF=512
# 粗排四权重（条件契合 / RRF / 曝光公平 / 反馈历史）
RECALL_W_CONDITION=0.40
RECALL_W_RRF=0.30
RECALL_W_FAIRNESS=0.10
RECALL_W_FEEDBACK=0.20
# 本地几何等时圈：纯本地计算，不接外部地图服务、不内置 key、不渲染地图
RECALL_ISO_ENABLED=true
RECALL_TIMEOUT_MS=30000

# ---- 大模型 ----
LLM_MODE=live
# 主模型：LongCat-2.5（OpenAI 兼容端点）
LLM_PRIMARY_BASE_URL=https://api.longcat.chat/openai/v1
LLM_PRIMARY_API_KEY=<LONGCAT_API_KEY>
LLM_PRIMARY_MODEL=LongCat-2.5
# 可选：模型级私有请求体参数（JSON 对象字符串），留空即可
LLM_PRIMARY_EXTRA_BODY=

# 备用模型：DeepSeek-V4.1-Flash-1017
# 模型名固定用 deepseek-flash（旧名 deepseek-v4-flash 已下线，按 Flash 计费）
# 端点用 OpenAI 兼容格式 https://api.deepseek.com，不要拼 /v1
LLM_FALLBACK_BASE_URL=https://api.deepseek.com
LLM_FALLBACK_API_KEY=<DEEPSEEK_API_KEY>
LLM_FALLBACK_MODEL=deepseek-flash
# 留空时代码对 deepseek-* 自动注入 {"thinking":{"type":"disabled"}}：
# 该模型默认开思考会返回 reasoning_content，极端情况下会把 content 挤空。
# 换用其他厂商模型时可在此显式覆盖，例如 qwen 需要 {"enable_thinking":false}
LLM_FALLBACK_EXTRA_BODY=

LLM_MAX_ATTEMPTS=3
LLM_TIMEOUT_MS=30000
LLM_RETRY_DELAY_MS=2000
LLM_CIRCUIT_THRESHOLD=5
